#!/bin/sh

message_file=$1
subject=$(sed -n '1p' "$message_file")

if printf '%s\n' "$subject" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9][a-z0-9-]*\))?!?: .+'; then
  exit 0
fi

printf '%s\n' 'Invalid commit subject. Use: type(optional-scope): short description' >&2
printf '%s\n' 'Example: feat(skills): add repository search skill' >&2
exit 1
